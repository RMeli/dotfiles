{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "cscs/zai-org/GLM-5.3",
  "providers": {
    "cscs": {
      "name": "CSCS",
      "npm": "@ai-sdk/anthropic",
      "env": ["CSCS_INFERENCE_API_KEY"],
      "settings": {
        "baseURL": "https://api.inference.cscs.ch/v1"
      },
      "models": {
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": {"context": 262144, "output": 16384}
        },
        "google/gemma-4-31B-it": {
          "name": "Gemma 4",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": {"context": 262144, "output": 16384}
        },
        "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16": {
          "name": "Nemotron 3",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": {"context": 262144, "output": 16384}
        },
        "zai-org/GLM-5.2": {
          "name": "GLM 5.2",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": {"context": 976000, "output": 16384}
        },
        "zai-org/GLM-5.3": {
          "name": "GLM 5.3",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] },
          "limit": {"context": 976000, "output": 16384}
        }
      }
    }
  },
  "mcp": {
    "cuda-docs": {
      "type": "remote",
      "url": "https://api.copilot.nsight.ngc.nvidia.com/mcp/cuda-docs",
      "enabled": false
    }
  },
  "formatter": true,
  "permission": {
    "bash": {
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -rf .": "deny",
      "rm -rf ..": "deny",
      "rm -fr /*": "deny",
      "rm -fr ~/*": "deny",
      "rm -fr $HOME/*": "deny",
      "rm *": "ask"
    }
  }
}
