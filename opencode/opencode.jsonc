{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "cscs/zai-org/GLM-5.2,
  "provider": {
    "cscs": {
      "name": "CSCS",
      "options": {
        "baseURL": "https://api.inference.cscs.ch/v1",
        "apiKey": "{env:CSCS_INFERENCE_API_KEY}"
      },
      "models": {
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi-K2.7-Code",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "google/gemma-4-31B-it": {
          "name": "Gemma 4",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16": {
          "name": "Nemotron 3",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "zai-org/GLM-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 976000,
            "output": 16384
          }
        }
      }
    },
    "cscs-tds": {
      "name": "CSCS-TDS",
      "options": {
        "baseURL": "https://ai-gateway.forno-tds.tds.cscs.ch/v1/",
        "apiKey": "{env:CSCS_INFERENCE_TDS_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 976000,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "cuda-docs": {
      "type": "remote",
      "url": "https://api.copilot.nsight.ngc.nvidia.com/mcp/cuda-docs",
      "enabled": false
    }
  },
  "formatter": true,
  "permission": {
    "bash": {
      "rm -rf /*": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME/*": "deny",
      "rm -rf .": "deny",
      "rm -rf ..": "deny",
      "rm -fr /*": "deny",
      "rm -fr ~/*": "deny",
      "rm -fr $HOME/*": "deny",
      "rm *": "ask"
    }
  }
}
